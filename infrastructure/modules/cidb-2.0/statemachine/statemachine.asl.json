                                    "JitterStrategy": "FULL"
                                }
                            ],
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "Lambda_Rebalance",
                    "States": {
                        "Lambda_Rebalance": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::lambda:invoke",
                            "ResultPath": "$.rebalanceResult",
                            "Parameters": {
                                "FunctionName": "${lambda_Rebalance}",
                                "Payload.$": "$"
                            },
                            "Retry": [
                                {
                                    "ErrorEquals": [
                                        "Lambda.ServiceException",
                                        "Lambda.AWSLambdaException",
                                        "Lambda.SdkClientException",
                                        "Lambda.TooManyRequestsException"
                                    ],
                                    "IntervalSeconds": 1,
                                    "MaxAttempts": 3,
                                    "BackoffRate": 2,
                                    "JitterStrategy": "FULL"
                                }
                            ],
                            "Next": "Map"
                        },
                        "Map": {
                            "Type": "Map",
                            "ItemProcessor": {
                                "ProcessorConfig": {
                                    "Mode": "DISTRIBUTED",
                                    "ExecutionType": "STANDARD"
                                },
                                "StartAt": "EvCIDB2_IAM_Policy",
                                "States": {
                                    "EvCIDB2_IAM_Policy": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::lambda:invoke",
                                        "ResultPath": null,
                                        "Parameters": {
                                            "FunctionName": "${EvCIDB2_IAM_Policy}",
                                            "Payload.$": "$.Value"
                                        },
                                        "Retry": [
                                            {
                                                "ErrorEquals": [
                                                    "Lambda.ServiceException",
                                                    "Lambda.AWSLambdaException",
                                                    "Lambda.SdkClientException",
                                                    "Lambda.TooManyRequestsException"
                                                ],
                                                "IntervalSeconds": 1,
                                                "MaxAttempts": 3,
                                                "BackoffRate": 2,
                                                "JitterStrategy": "FULL"
                                            }
                                        ],
                                        "End": true
                                    }
                                }
                            },
                            "End": true,
                            "MaxConcurrency": 10,
                            "Label": "Map",
                            "ItemReader": {
                                "Resource": "arn:aws:states:::s3:getObject",
                                "ReaderConfig": {
                                    "InputType": "JSON",
                                    "MaxItems": 10
                                },
                                "Parameters": {
                                    "Bucket.$": "$.rebalanceResult.Payload.bucket",
                                    "Key.$": "$.rebalanceResult.Payload.s3_key"
                                }
                            },
                            "ResultSelector": {},
                            "ResultPath" : null
                        }
                    }
                }
            ],
            "Next": "Lambda_Merge"
        },
        "Lambda_Merge": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "ResultPath": null,
            "Parameters": {
                "FunctionName": "${lambda_merge}",
                "Payload": {
                    "Status": "All tasks completed"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "End": true
        }
    }
