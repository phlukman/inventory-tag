                                        "Lambda.TooManyRequestsException"
                                    ],
                                    "IntervalSeconds": 1,
                                    "MaxAttempts": 3,
                                    "BackoffRate": 2,
                                    "JitterStrategy": "FULL"
                                }
                            ],
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "EvCIDB2_CWA",
                    "States": {
                        "EvCIDB2_CWA": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::lambda:invoke",
                            "ResultPath": null,
                            "Parameters": {
                                "FunctionName": "${EvCIDB2_CWA}",
                                "Payload.$": "$"
                            },
                            "Retry": [
                                {
                                    "ErrorEquals": [
